<?xml version="1.0" encoding="utf-8"?>
<!-- 高德 API Key 设置弹窗内容：说明 + 包名/SHA1 一键复制 + 带浮动标签的输入框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="两种 Key 均为可选（地图底图不填也能显示）。推荐填「Web服务 Key」——申请最简单、无需绑定包名，搜索更稳定。创建时的绑定信息如下："
        android:textColor="#666666"
        android:textSize="13sp" />

    <!-- 包名 / SHA1 信息行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_dropdown"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444444"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sha1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#444444"
                android:textSize="12sp"
                android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="复制"
                android:textSize="12sp"
                android:textColor="#5B8DEF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Web 服务 Key 输入框（推荐：申请最简单，搜索走高德 API 国内稳定） -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Web 服务 Key（推荐，搜索更稳定）"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="#5B8DEF">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_api_key_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Android 平台 Key 输入框（可选：绑定包名+SHA1，SDK 原生搜索通道） -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Android 平台 Key（可选）"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="#5B8DEF">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="什么都不填：搜索走 OpenStreetMap 公共通道（需网络可达）；仅填 Web Key：搜索最稳定；之后可长按顶部状态文字重新填写"
        android:textColor="#AAAAAA"
        android:textSize="11sp" />
</LinearLayout>
